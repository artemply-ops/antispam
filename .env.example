# Скопируй в .env и заполни. Файл .env никому не отправляй.
BOT_TOKEN=токен_от_BotFather
OWNER_ID=твой_числовой_id_телеграм
CHANNEL_ID=-1001901682519
# Можно не заполнять: бот найдёт чат обсуждения сам. Если не нашёл, напиши /chatid в группе
DISCUSSION_CHAT_ID=

# 1 = тестовый режим: только присылает отчёты, никого не банит. После пары дней поставь 0
DRY_RUN=1
BAN_SCORE=5
SUSPECT_SCORE=3
# После скольких чистых комментариев человек становится доверенным и больше не проверяется
TRUST_AFTER=3
# Проверка по открытой базе спамеров CAS (api.cas.chat), туда уходит только числовой id
CAS_ENABLED=1
DB_PATH=antispam.db
