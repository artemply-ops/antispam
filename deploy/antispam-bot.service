[Unit]
Description=Antispam bot for Telegram channel comments
After=network-online.target
Wants=network-online.target

[Service]
User=antispam
Group=antispam
WorkingDirectory=/opt/antispam
ExecStart=/opt/antispam/.venv/bin/python /opt/antispam/bot.py
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/antispam

[Install]
WantedBy=multi-user.target
